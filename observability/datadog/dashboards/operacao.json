{
  "title": "Mecânica — Operação",
  "description": "Visão operacional (Fase 3 estendida): volume de OS, tempo por situação, erros de integração, latência e recursos por serviço.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "tags": [],
  "template_variables": [
    {
      "name": "service",
      "prefix": "service",
      "default": "*"
    }
  ],
  "template_variable_presets": [],
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "Volume diário de OS",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "sum:saga.iniciada{env:prd,$service}.as_count().rollup(sum, 86400)",
            "display_type": "bars",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Tempo médio por situação",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "avg:os.tempo_por_situacao{env:prd,$service} by {situacao}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Mercado Pago: erros por operação",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "sum:mercadopago.erros{env:prd,$service} by {operacao}.as_count()",
            "display_type": "bars",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Webhook por resultado",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "sum:webhook.recebido{env:prd,$service} by {resultado}.as_count()",
            "display_type": "bars",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Respostas 5xx por serviço",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "count:http.server.request.duration{env:prd,http.response.status_code:5*,$service} by {service}.as_count()",
            "display_type": "bars",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Latência HTTP p95 por serviço (s)",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "p95:http.server.request.duration{env:prd,$service} by {service}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Memória usada por serviço",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "avg:jvm.memory.used{env:prd,$service} by {service}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU por serviço",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "q": "avg:k8s.pod.cpu.utilization{env:prd,$service} by {service}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ]
      }
    }
  ],
  "notify_list": []
}
