{
  "name": "Mecânica — Mercado Pago com erro",
  "type": "query alert",
  "query": "sum(last_10m):sum:mercadopago.erros{env:prd}.as_count() > 0",
  "message": "Erro na integração com o Mercado Pago ({{operacao.name}}). Conferir `mercadopago.erros` por operação e os logs do mecanica-billing.",
  "tags": [
    "projeto:mecanica-fase4"
  ],
  "options": {
    "thresholds": {
      "critical": 0
    },
    "notify_no_data": false,
    "require_full_window": false,
    "notify_audit": false,
    "include_tags": true,
    "renotify_interval": 0,
    "no_data_timeframe": null,
    "evaluation_delay": 60
  }
}
